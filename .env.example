# ── Database (any Postgres: Supabase self-hosted / cloud, plain Postgres) ──
# Always keep `?schema=nexdrop` on Supabase: tables in `public` are exposed by Supabase's REST API.
#
# Supabase on the same Coolify server (internal network, fastest):
#   DATABASE_URL="postgresql://postgres:<POSTGRES_PASSWORD>@supabase-db:5432/postgres?schema=nexdrop&connection_limit=10"
# Through Supavisor transaction pooler (port 6543) add `pgbouncer=true`, and point DIRECT_URL at port 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexdrop_admin?schema=nexdrop"
# Direct (non-pooled) connection used by `prisma migrate deploy`
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nexdrop_admin?schema=nexdrop"

# ── Auth ──
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# First super admin, created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@nexdrop.app"
SEED_ADMIN_PASSWORD="change-me-now-please"
# Docker/Coolify: run the seed on start (plans + super admin). Set back to false after the first deploy.
RUN_SEED="false"
# Also create demo stores, products and orders
SEED_DEMO="false"

# 32-byte key (base64) used to encrypt payment gateway secrets at rest
# generate-with: openssl rand -base64 32
ENCRYPTION_KEY=""

# ── Storage ──
# "local" writes to ./storage — fine on a VPS when /app/storage is a persistent volume (Coolify: Storages).
# "s3" works with Supabase Storage (S3 protocol), MinIO, Cloudflare R2, AWS S3.
#   Supabase: S3_ENDPOINT=https://<supabase-host>/storage/v1/s3
#             S3_PUBLIC_URL=https://<supabase-host>/storage/v1/object/public/<bucket>
STORAGE_DRIVER="local"
S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL of the bucket (R2 custom domain / CDN), used for media links
S3_PUBLIC_URL=""

# ── Themes & storefronts ──
# Max theme zip size in MB
THEME_MAX_ZIP_MB="80"
# Optional: serve storefronts on {store}.STOREFRONT_ROOT_DOMAIN (wildcard DNS)
STOREFRONT_ROOT_DOMAIN=""

# ── Marketplace sync (NexDrop) ──
# Published/archived theme events are POSTed here, signed with HMAC-SHA256
MARKETPLACE_WEBHOOK_URL=""
MARKETPLACE_WEBHOOK_SECRET=""
